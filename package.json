{
  "name": "hopper-gtfs-plugin",
  "version": "0.1.0-dev.3",
  "type": "module",
  "description": "Native OpenClaw transit tools with public GTFS catalog discovery.",
  "license": "MIT",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "csv-parse": "6.1.0",
    "gtfs": "4.21.0",
    "gtfs-realtime-bindings": "2.2.0",
    "better-sqlite3": "13.0.3",
    "typebox": "1.4.3",
    "yauzl": "3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/better-sqlite3": "7.6.13",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/yauzl": "2.10.3"
  },
  "scripts": {
    "build": "esbuild src/*.ts --platform=node --format=esm --outdir=dist --packages=external",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  }
}
